# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://restaurantos:restaurantos@localhost:5432/restaurantos
POSTGRES_USER=restaurantos
POSTGRES_PASSWORD=restaurantos
POSTGRES_DB=restaurantos

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Backend (Express) ────────────────────────────────────
NODE_ENV=development
PORT=4000
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ── AI Service (FastAPI) ─────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
OPENAI_API_KEY=sk-your-openai-key-here

# ── Frontend (Vite) ──────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000
